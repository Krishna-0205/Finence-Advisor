{
  "name": "finance-advisor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build && node scripts/build-worker.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --no-liftoff --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "start": "node --env-file-if-exists=.env server.mjs",
    "build:site": "npm run build",
    "db:generate": "drizzle-kit generate",
    "setup:demo": "node scripts/setup-demo.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "1.168.57",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "latest",
    "papaparse": "^5.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20260921.0-alpha",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.0.0",
    "tsx": "latest",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
